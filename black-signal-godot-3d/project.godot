; BLACK SIGNAL / native 3D
config_version=5

[application]
config/name="BLACK SIGNAL 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/image="res://icon.png"
boot_splash/bg_color=Color(0.025,0.035,0.065,1)
boot_splash/show_image=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/size/window_width_override=1280
window/size/window_height_override=720

[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025,0.035,0.065,1)
